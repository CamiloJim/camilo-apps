# Proyecto de Supabase de camilo-apps (org marketingascendia's Org, capa Free).
# Sacar los valores reales de: Supabase Dashboard > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRETA — solo servidor, nunca con prefijo NEXT_PUBLIC_ (eso la expondria al
# navegador). Salta toda la RLS, asi que no se comparte ni se commitea.
# Habilita el cache de datos de mercado; sin ella la app funciona igual, pero
# le pide todo a Yahoo en cada consulta y el rate limit llega antes.
# Dashboard > Project Settings > API Keys > service_role.
SUPABASE_SERVICE_ROLE_KEY=
